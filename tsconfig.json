{
  "compilerOptions": {
    "target": "ES2022",
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "noEmit": true,
    "incremental": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "types": ["node"],
    "paths": {
      "@/*": ["./*"],
      "@hrms/api-contract": ["./packages/api-contract/src/index.ts"],
      "@hrms/domain": ["./packages/domain/src/index.ts"],
      "@hrms/config": ["./packages/config/src/index.ts"],
      "@hrms/ui-tokens": ["./packages/ui-tokens/src/index.ts"]
    },
    "jsx": "preserve",
    "plugins": [{ "name": "next" }]
  },
  "exclude": ["node_modules", ".next", "supabase", "android"],
  "include": [
    "next-env.d.ts",
    ".next/types/**/*.ts",
    "**/*.ts",
    "**/*.tsx"
  ]
}
