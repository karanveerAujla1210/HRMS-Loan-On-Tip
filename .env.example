# ─────────────────────────────────────────────────────────────────────────────
# Loan On Tip HRMS — environment variables
# Copy to .env.local for local development. NEVER commit .env.local.
# ─────────────────────────────────────────────────────────────────────────────

# ── Public (safe to expose to the browser) ───────────────────────────────────
# Supabase project URL.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Supabase publishable ("anon") key. Row Level Security protects all data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# ── Server-only (NEVER prefix with NEXT_PUBLIC_) ─────────────────────────────
# Service-role key. Used exclusively by /api/v1 route handlers for privileged,
# already-authorised operations (audit log writes, idempotency, payroll, etc.).
# Leaking this key bypasses every Row Level Security policy.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shared secret required by scheduled jobs (attendance daily close).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# ── Optional ─────────────────────────────────────────────────────────────────
# Public base URL of the deployment, used for absolute links in the mobile shell.
NEXT_PUBLIC_APP_URL=http://localhost:3000
