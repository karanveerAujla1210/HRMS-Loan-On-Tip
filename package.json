{
  "name": "loanontip-hrms",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspace=apps/web",
    "start": "npm run start --workspace=apps/web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:lint": "vitest run tests/db",
    "mobile:start": "npm run start --workspace=@loanontip/mobile",
    "mobile:android": "npm run android --workspace=@loanontip/mobile",
    "mobile:typecheck": "npm run typecheck --workspace=@loanontip/mobile"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@types/node": "^22.13.9",
    "@types/pg": "^8.23.1",
    "eslint": "^9.18.0",
    "pg": "^8.13.1",
    "typescript": "^5.8.2",
    "vitest": "^2.1.9"
  }
}
